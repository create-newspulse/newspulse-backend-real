NODE_ENV=development

# Server port (optional, defaults to 5000)
PORT=5000

# Local dev requires MongoDB running (local or Atlas).
# Database name must clearly be a dev/local/test database; startup refuses
# production-looking names when NODE_ENV=development.
MONGODB_URI=mongodb://127.0.0.1:27017/newspulse_dev

# JWT secret (dev only)
JWT_SECRET=dev_secret_change_later
REPORTER_PORTAL_SESSION_SECRET=dev_reporter_session_secret_change_later

# Local Reporter Portal OTP uses development stub delivery.
EMAIL_MODE=stub

# Admin panel credentials (used by POST /admin/login)
# These must match what your admin UI expects for login.
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=replace-me
FOUNDER_NAME=NewsPulse Founder
FOUNDER_ID=founder-1
