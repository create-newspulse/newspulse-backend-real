{
  "compilerOptions": {
    "checkJs": false,
    "maxNodeModuleJsDepth": 2,
    "module": "commonjs",
    "target": "es2020"
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": [
    "server.js",
    "controllers/**/*.js",
    "lib/**/*.js",
    "middleware/**/*.js",
    "models/**/*.js",
    "routes/**/*.js",
    "scripts/**/*.js",
    "services/**/*.js",
    "src/**/*.js",
    "tests/**/*.js",
    "utils/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "newspulse-backend-real-main/**"
  ]
}
