# NewsPulse Backend Environment Variables (Root Server)
# Copy this file to .env and fill in values.

# --- Application Port ---
# Preferred port (server will auto-fallback to next ports if occupied)
PORT=10000

# --- MongoDB ---
# Provide a valid Mongo connection string or leave blank to run without DB
# MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/yourdb
MONGO_URI=

# --- Founder/Admin Credentials ---
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=strong-password-here
FOUNDER_NAME=Site Founder
FOUNDER_ID=founder-1

# --- JWT ---
# In production set this to a long random string (e.g., 64+ chars)
JWT_SECRET=replace-with-secure-random-value

# --- Redis (optional) ---
# Provide a Redis connection string to enable distributed rate limiting
# Example: redis://default:password@host:6379
REDIS_URL=

# --- Token TTL Overrides ---
# Access token lifetime in minutes (default 15)
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# --- Optional ---
NODE_ENV=development
