# NewsPulse Backend Environment Variables (Root Server)
# Copy this file to .env and fill in values.

# --- Application Port ---
# Preferred port (server will auto-fallback to next ports if occupied)
PORT=10000

# --- MongoDB ---
# Provide a valid Mongo connection string or leave blank to run without DB
# MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/yourdb
MONGO_URI=

# --- Founder/Admin Credentials ---
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=strong-password-here
FOUNDER_NAME=Site Founder
FOUNDER_ID=founder-1

# --- JWT ---
# In production set this to a long random string (e.g., 64+ chars)
JWT_SECRET=replace-with-secure-random-value

# --- Redis (optional) ---
# Provide a Redis connection string to enable distributed rate limiting
# Example: redis://default:password@host:6379
REDIS_URL=

# --- Token TTL Overrides ---
# Access token lifetime in minutes (default 15)
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# --- SMTP Configuration (for OTP / transactional emails) ---
# Option A: explicit host/port (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true            # true for port 465; set false (or remove) for 587 STARTTLS
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password   # Use an App Password, not your account password
EMAIL_FROM="NewsPulse Admin <your-email@gmail.com>"  # Display name + address
# Optional override if you need a different envelope sender
SMTP_FROM=noreply@newspulse.co.in

# Option B: provider shortcut (comment HOST/PORT and use service)
# SMTP_SERVICE=gmail

# Advanced / optional tuning
SMTP_POOL=true              # Connection pooling for higher throughput
SMTP_MAX_CONN=3             # Max pooled connections
SMTP_DEBUG=false            # Set true to enable Nodemailer internal logger

# --- Optional ---
NODE_ENV=development
PASSWORD_HASH_ROUNDS=10
SECURE_COOKIE=true

# --- OTP Flow Tuning ---
OTP_ALLOW_ANY=1             # 0 in production to restrict to founder email
OTP_DEV_ECHO=0              # 1 only in local dev to echo OTP in response
OTP_EMAIL_TIMEOUT_MS=5000   # Background send timeout safeguard
