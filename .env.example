# Copy this file to `.env` and fill in real values.
# IMPORTANT: Never commit `.env` with real secrets.
# In production (e.g., Render), set environment variables in the dashboard.

NODE_ENV=development
PORT=5000

# MongoDB connection string (single source of truth)
# Provide the full URI exactly as you want Mongoose to connect.
# Examples:
#   MONGODB_URI=mongodb://127.0.0.1:27017/my_database
#   MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/my_database?retryWrites=true&w=majority
MONGODB_URI=

# JWT secret (dev only)
JWT_SECRET=dev_secret_change_later

# --- Optional / production settings below ---

# Founder/Admin Auth (placeholders)
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_me
FOUNDER_ID=founder-001
FOUNDER_NAME=Founder
## JWT_SECRET is defined above for local dev; override in production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SECURE_COOKIE=true

# CORS allowlist (comma-separated)
# IMPORTANT: Must match your frontend origin exactly (port matters).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Compatibility alias (older setups)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Email (Gmail App Password recommended)
# Use either SERVICE preset OR explicit host/port
SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=newspulse.team@gmail.com
SMTP_PASS=<APP_PASSWORD>
EMAIL_FROM="NewsPulse <newspulse.team@gmail.com>"
SMTP_DEBUG=false

# Optional Redis
# REDIS_URL=redis://localhost:6379
