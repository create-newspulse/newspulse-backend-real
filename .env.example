# Copy this file to `.env` and fill in real values.
# IMPORTANT: Never commit `.env` with real secrets.
# In production (e.g., Render), set environment variables in the dashboard.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (placeholder)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# Founder/Admin Auth (placeholders)
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_me
FOUNDER_ID=founder-001
FOUNDER_NAME=Founder
JWT_SECRET=change_me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SECURE_COOKIE=true

# CORS allowlist (comma-separated)
# IMPORTANT: Must match your frontend origin exactly (port matters).
# Examples:
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# CORS_ORIGIN=http://127.0.0.1:5173
# (If you use a different port, add it here.)
# CORS_ORIGIN=

# Email (Gmail App Password recommended)
# Use either SERVICE preset OR explicit host/port
SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=newspulse.team@gmail.com
SMTP_PASS=<APP_PASSWORD>
EMAIL_FROM="NewsPulse <newspulse.team@gmail.com>"
SMTP_DEBUG=false

# Optional Redis
# REDIS_URL=redis://localhost:6379
